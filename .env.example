# =========================
# DQBH APPLICATION
# =========================

APP_NAME=DQBH
APP_ENV=development
DEBUG=true

# =========================
# BACKEND
# =========================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# =========================
# DATABASE
# =========================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dqbh

# =========================
# REDIS
# =========================

REDIS_URL=redis://localhost:6379/0

# =========================
# AUTH
# =========================

JWT_SECRET_KEY=change_this_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# AI
# =========================

LLM_API_KEY=
LLM_MODEL=

# =========================
# STORAGE
# =========================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dqbh

# =========================
# FRONTEND
# =========================

VITE_API_BASE_URL=http://127.0.0.1:8000
